  <g transform={`translate(${x} ${y})`} filter="url(#ps)">
    {[[0, 0], [1, 0], [2, 0], [0.5, 1], [1.5, 1], [1, 2]].map(([i, r], k) => (
      <g key={k} transform={`translate(${(i - 1) * 120} ${-r * 62})`}>
