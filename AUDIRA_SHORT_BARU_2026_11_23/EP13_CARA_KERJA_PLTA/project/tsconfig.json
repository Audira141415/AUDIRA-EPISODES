{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": ["src/*.ts", "src/*.tsx", "src/styles/**/*.tsx", "src/components/*.tsx", "src/lib/*", "src/brand/*", "src/episodes/**/*"]
}
