      // figures
      const wv = ramp(t, A("s3:Willis") - 0.2, A("s3:Willis") + 0.4) * (1 - ramp(t, A("s3:merancang") - 0.2, A("s3:merancang") + 0.4));
      pose(wil, { aL: 0.2 + 2.2 * ramp(t, A("s3:merancang") - 0.1, A("s3:merancang") + 0.5) * (t > K.s3 ? 1 : 0) - 0.0, eL: 0.5, aR: -0.35 - 0.4 * wv * (1 + 0.3 * Math.sin(t * 9)), eR: -1.1 + 0.4 * wv, hz: 0.06 * Math.sin(t * 0.8) });
      wil.armL.sh.rotation.z = -(0.2 + 1.1 * ramp(t, A("s3:merancang"), A("s3:merancang") + 0.5) * (t > K.s3 ? 1 : 0));
      wil.G.visible = t >= K.s3 - 0.1; plate.visible = t >= K.s3 - 0.1;
      pose(wk, { aL: 0.5 + 0.2 * Math.sin(t * 4.4), eL: -1.0, aR: -0.6 - 0.2 * Math.sin(t * 4.4), eR: 1.0, hz: -0.1 });
    }

    // ================= HOUSE =================
    if (HO.visible) {
      const s8 = t > K.s8;
      const open = s8 ? 1 : ramp(t, A("s4:unit") - 0.2, A("s4:unit") + 0.7);
      hinge.rotation.x = -0.95 * back(open, 0.8);
      const cold = s8 ? 1 : ramp(t, A("s4:evaporator") - 0.3, A("s4:dingin"));
      coldL.intensity = 5 * cold * open;
      frost.material.emissiveIntensity = 0.22 * cold;
      finM.emissiveIntensity = 0.16 * cold + 0.05 * cold * Math.sin(t * 3);
      const fan = s8 ? 1 : ramp(t, A("s4:Kipas") - 0.4, A("s4:Kipas") + 0.3);
      cff.rotation.x = t * 14 * Math.max(0.2, fan);
      louver.rotation.x = 0.25 * Math.sin(t * 0.9) * fan;
      led.material.emissiveIntensity = 1.2 + 0.8 * Math.sin(t * 4);
      roomCold.forEach((f) => f(t, (t > K.s5 + 0.4 && !s8 ? 0 : 1) * Math.max(fan, ramp(t, K.s4, K.s4 + 0.6) * 0.6)));
      roomWarm.forEach((f) => f(t, (t < A("s4:evaporator") - 0.5 || s8 ? 1 : 0) * Math.max(fan, ramp(t, K.s4, K.s4 + 0.6) * 0.6)));
      // condensation on the fins: drops grow, slide down, fall into the tray
      const cond = s8 ? 1 : ramp(t, A("s5:menyentuh"), A("s5:mengembun") + 0.3);
      iuDS.forEach((d, i) => {
        const u = ((t / d[2] + d[1]) % 1);
        const grow = clamp01(u / 0.45), slide = clamp01((u - 0.45) / 0.45);
        o3.position.set(d[0], 0.27 - d[3] - (0.3 - d[3] * 0.5) * slide * slide, 0.142);
        o3.scale.set(0.018 + 0.014 * grow, (0.018 + 0.014 * grow) * (1 + 0.5 * slide), 0.02);
        if (cond < 0.02 || u > 0.92) o3.scale.setScalar(0.0001); else o3.scale.multiplyScalar(cond);
        o3.updateMatrix(); iuDrops.setMatrixAt(i, o3.matrix);
      });
      iuDrops.instanceMatrix.needsUpdate = true;
      // hose drips into the jar; the jar fills through the film
      const drip = s8 || t > A("s5:selang") - 0.5;
      for (let i = 0; i < 4; i++) { const u = ((t * 0.9 + i / 4) % 1); o3.position.set(3.2, 0.58 - 0.5 * u * u * 1.6, -2.05); const sc = drip ? 0.035 * (u < 0.1 ? u / 0.1 : 1) : 0.0001; o3.scale.set(sc, sc * 1.3, sc); o3.updateMatrix(); hoseDrops.setMatrixAt(i, o3.matrix); }
      hoseDrops.instanceMatrix.needsUpdate = true;
      const lvl = 0.06 + 0.16 * ramp(t, A("s5:selang"), K.s6) + 0.2 * ramp(t, K.s8, A("s8:pengering") + 1.5);
      water.scale.y = lvl; water.position.y = lvl / 2 + 0.01;
      // room thermometer drops once the unit runs
      thFill.scale.y = 0.85 - 0.45 * ramp(t, A("s4:Kipas"), K.s5e);
      // refrigerant + outdoor unit
      const ref = s8 ? 1 : ramp(t, A("s6:Panas") - 0.4, A("s6:refrigeran"));
      const inv = t > A("s6:inverter") - 0.3 && !s8;
      const tmp = (x) => 0.5 + 0.32 * Math.sin(x * 1.1) + 0.12 * Math.sin(x * 2.3 + 1);
      const spd = inv ? tmp(t - 0.35) : 0.85;
      arrHot(t, ref, 0.1 + 0.08 * spd, -1); arrCold(t, ref, 0.1 + 0.08 * spd, 1);
      const fanAng = inv ? (0.5 * t - 0.32 / 1.1 * Math.cos((t - 0.35) * 1.1) - 0.12 / 2.3 * Math.cos((t - 0.35) * 2.3 + 1)) * 16 : t * 13.6;
      ouFan.rotation.z = -(t < K.s6 - 1 && !s8 ? t * 3 : fanAng);
      comp3.position.x = 0.66 + 0.006 * Math.sin(t * 60) * spd * ref; comp3.rotation.y = 0.04 * Math.sin(t * 37) * spd * ref;
      condM.emissiveIntensity = 0.6 * ref * (0.6 + 0.4 * spd);
      const ho = s8 ? 1 : ramp(t, A("s6:kipasnya") - 0.5, A("s6:membuang"));
      heatOut.forEach((f) => f(t, ho * (0.5 + 0.5 * spd))); heatTag.scale.setScalar(Math.max(0.001, s8 ? 0 : ho)); heatTag.position.y = 2.5 + 0.03 * Math.sin(t * 1.3);
      ibNeedle.rotation.z = Math.PI / 2 - Math.PI * (0.08 + 0.84 * spd);
      ibBar.scale.x = Math.max(0.02, inv ? tmp(t) : 0.85);
      const kp = s8 ? 0 : 1; kid.G.rotation.y = 0.25; pose(kid, { aL: 0.7, eL: -1.4, aR: -0.7, eR: 1.4, sit: 1, hz: 0.05 * Math.sin(t * 0.7) });
      kid.head.rotation.z = 0.05 * Math.sin(t * 0.7) + 0.08 * kp * ramp(t, A("s4:Kipas"), A("s4:Kipas") + 1);
    }

    // ================= PK =================
    if (PK.visible) {
      const tq = A("s7:PK"), t9 = A("s7:sembilan"), t2 = A("s7:dua"), t7 = A("s7:tujuh"), t3 = A("s7:tiga");
      stampG.scale.setScalar(Math.max(0.001, back(clamp01((t - tq + 0.1) / 0.4)))); stampG.rotation.z = -0.12;
      blocks.forEach((b, i) => { const p = back(clamp01((t - t9 + 0.1 - i * 0.18) / 0.4), 1.4); b.scale.set(1, Math.max(0.001, p), 1); });
      vHeat.material.opacity = 0.25 + 0.75 * ramp(t, t9, t9 + 0.3); vHeat.scale.setScalar(1 + 0.08 * win(t, t2, t2 + 0.6, 0.15));
      elec.scale.set(1, Math.max(0.001, back(clamp01((t - t7 + 0.1) / 0.45), 1.4)), 1);
      vElec.material.opacity = ramp(t, t7, t7 + 0.3);
      nums.forEach((m, i) => { const p = ramp(t, t3 - 0.1 + i * 0.22, t3 + 0.15 + i * 0.22); m.material.opacity = p; m.scale.setScalar(0.6 + 0.4 * back(p)); });
      pkCold.forEach((f) => f(t, ramp(t, A("s7:split") - 0.3, A("s7:split") + 0.3)));
    }
    comp.render();
  };
}
