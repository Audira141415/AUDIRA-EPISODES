  const causTex = canvasTex(512, 512, (c, w, h) => { c.fillStyle = "#000"; c.fillRect(0, 0, w, h); c.strokeStyle = "rgba(160,255,250,.55)"; c.lineWidth = 3; const R = mulberry(21);
    for (let i = 0; i < 70; i++) { c.beginPath(); let x = R() * w, y = R() * h; c.moveTo(x, y); for (let k = 0; k < 5; k++) { x += (R() - 0.5) * 120; y += (R() - 0.5) * 120; c.quadraticCurveTo(x + 30, y - 30, x, y); } c.stroke(); } }, [24, 24]);
