  function buildAircraft(mat, frameMat, flat) {
    const g = new THREE.Group();
    const prof = [];
    for (let i = 0; i <= 40; i++) { const y = -345 + i * 3; const k = i / 40; prof.push(new THREE.Vector2(20 * Math.sqrt(Math.max(0, 1 - Math.pow(1 - k, 2))) + 0.01, y)); }
    prof.push(new THREE.Vector2(20, -60));
    for (let i = 1; i <= 20; i++) { const k = i / 20; prof.push(new THREE.Vector2(20 - 17 * Math.pow(k, 1.2), -60 + k * 105)); }
    const fus = new THREE.LatheGeometry(prof, 40); fus.rotateZ(-Math.PI / 2);
    // lathe y -> -x after rotation; flip so nose sits at -x
    const fm = new THREE.Mesh(fus, mat); g.add(fm);
    for (let x = -300; x <= 30; x += 9) {
      const k = x < -60 ? 1 : 1 - 0.85 * Math.pow((x + 60) / 105, 1.2);
      const ring = new THREE.Mesh(new THREE.TorusGeometry(20 * k, 0.12, 4, 48), frameMat); ring.rotation.y = Math.PI / 2; ring.position.x = x; g.add(ring);
    }
    const fin = new THREE.Shape(); fin.moveTo(-28, 0); fin.lineTo(30, 0); fin.lineTo(48, 62); fin.lineTo(26, 62); fin.closePath();
    const finG = new THREE.ExtrudeGeometry(fin, { depth: 1.4, bevelEnabled: false }); finG.translate(0, 0, -0.7);
    const fi = new THREE.Mesh(finG, flat); fi.position.y = 6; g.add(fi);
    const stab = new THREE.Shape(); stab.moveTo(-14, 0); stab.lineTo(22, 0); stab.lineTo(40, 52); stab.lineTo(28, 52); stab.closePath();
    [1, -1].forEach((sd) => { const sg = new THREE.ExtrudeGeometry(stab, { depth: 0.9, bevelEnabled: false }); const m = new THREE.Mesh(sg, flat); m.rotation.x = sd * Math.PI / 2; m.position.y = 3; g.add(m); });
    const wing = new THREE.Shape(); wing.moveTo(-205, 0); wing.lineTo(-145, 0); wing.lineTo(-95, 150); wing.lineTo(-112, 150); wing.closePath();
    [1, -1].forEach((sd) => { const wg = new THREE.ExtrudeGeometry(wing, { depth: 2, bevelEnabled: false }); const m = new THREE.Mesh(wg, flat); m.rotation.x = sd * Math.PI / 2; m.position.y = -8; g.add(m);
      const en = new THREE.Mesh(new THREE.CylinderGeometry(7, 6, 30, 28, 1, true), mat); en.rotation.z = Math.PI / 2; en.position.set(-200, -16, sd * 52); g.add(en); });
    g.position.y = 3;
    return g;
