  const sg = new THREE.PlaneGeometry(400, 400, 120, 120); sg.rotateX(-Math.PI / 2);
  { const pa = sg.attributes.position; for (let i = 0; i < pa.count; i++) { const x = pa.getX(i), z = pa.getZ(i); const d = Math.hypot(x + 0.3, z); pa.setY(i, (Math.sin(x * 0.21) * Math.cos(z * 0.17) * 0.8 + Math.sin(x * 0.07 + z * 0.05) * 2.2) * Math.min(1, d / 10)); } sg.computeVertexNormals(); }
