  // ---------- callout labels ----------
  function label(text, accent = "#ff6a1a") {
    const fs = 64, pad = 34;
    const cv = document.createElement("canvas"); const cx = cv.getContext("2d"); cx.font = `bold ${fs}px Arial`;
    const tw = Math.ceil(cx.measureText(text).width);
    const tex = canvasTex(tw + pad * 2, fs + 46, (c, w, h) => {
      c.fillStyle = "rgba(246,241,231,.96)"; c.beginPath(); c.roundRect(2, 2, w - 4, h - 4, (h - 4) / 2); c.fill();
      c.fillStyle = accent; c.beginPath(); c.arc(pad * 0.55, h / 2, 9, 0, 6.28); c.fill();
      c.fillStyle = "#16202a"; c.font = `bold ${fs}px Arial`; c.textBaseline = "middle"; c.fillText(text, pad + 4, h / 2 + 3);
    });
    const sp = new THREE.Sprite(new THREE.SpriteMaterial({ map: tex, depthTest: false, depthWrite: false, transparent: true }));
    sp.renderOrder = 20; sp.userData.ar = (tw + pad * 2) / (fs + 46); S.add(sp);
    const lg = new THREE.BufferGeometry().setFromPoints([v3(0, 0, 0), v3(0, 0, 0)]);
    const ln = new THREE.Line(lg, new THREE.LineBasicMaterial({ color: accent, depthTest: false, transparent: true })); ln.renderOrder = 19; ln.frustumCulled = false; S.add(ln);
    const dot = new THREE.Sprite(new THREE.SpriteMaterial({ map: glowTex, depthTest: false, transparent: true, blending: THREE.AdditiveBlending })); dot.renderOrder = 19; S.add(dot);
    return { sp, ln, dot };
  }
  const _w = new THREE.Vector3();
  function setLabel(L, target, off, a) {
    const vis = a > 0.01;
    L.sp.visible = L.ln.visible = L.dot.visible = vis;
    if (!vis) return;
    const p = target.clone().add(off);
    const d = p.distanceTo(cam.position), k = d * 0.034;
    L.sp.position.copy(p); L.sp.scale.set(k * L.sp.userData.ar * 0.5, k * 0.5, 1);
    L.sp.material.opacity = a; L.ln.material.opacity = a; L.dot.material.opacity = a;
    const pa = L.ln.geometry.attributes.position; pa.setXYZ(0, target.x, target.y, target.z); pa.setXYZ(1, p.x, p.y - k * 0.2, p.z); pa.needsUpdate = true;
    L.dot.position.copy(target); L.dot.scale.setScalar(k * 0.22);
  }
