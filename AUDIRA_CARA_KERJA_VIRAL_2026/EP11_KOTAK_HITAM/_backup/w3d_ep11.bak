    const tg = new THREE.Mesh(new THREE.PlaneGeometry(0.9, 0.17), new THREE.MeshBasicMaterial({ map: panelTex(tl3[k]), transparent: true, depthWrite: false })); tg.position.set(-1.12, LABY[k], 1.58); lab.add(tg);
  }
  const hdr = new THREE.Mesh(new THREE.PlaneGeometry(1.8, 0.2), new THREE.MeshBasicMaterial({ map: canvasTex(900, 100, (c, w, h) => { c.fillStyle = "rgba(255,106,26,.9)"; c.fillRect(0, 0, w, h); c.fillStyle = "#101820"; c.font = "bold 58px Arial"; c.fillText("AUDIRA LAB · PEMBACA DATA", 22, 72); }), transparent: true, depthWrite: false }));
  hdr.position.set(0.55, -34.98, 1.6); hdr.scale.setScalar(0.7); lab.add(hdr);
  const pathPts = []; for (let i = 0; i <= 60; i++) { const u = i / 60; pathPts.push(v3(-1.6 + 3.2 * u, -33.85 + 0.2 * Math.sin(u * 3) - (u > 0.75 ? (u - 0.75) * 1.2 : 0), 1.3 + 0.4 * Math.sin(u * 2.4))); }
  const pathCurve = new THREE.CatmullRomCurve3(pathPts);
  const pathM = flowMat(0xffffff, 1); const pathT = tube(pathPts, 0.012, pathM, 0, 160); lab.add(pathT);
  const miniM = ghostMat(0xbff8ff), miniF = ghostMat(0xbff8ff);
  const miniP = ghostMat(0xbff8ff, 0.2);
  const mini = buildAircraft(miniM, miniF, miniP); mini.scale.setScalar(0.0024); S.add(mini);

  // ---------- post: bloom + teal-orange grade ----------
  const comp = new EffectComposer(r, new THREE.WebGLRenderTarget(W, H, { type: THREE.HalfFloatType, samples: 4 }));
  comp.addPass(new RenderPass(S, cam));
  const bloom = new UnrealBloomPass(new THREE.Vector2(W / 2, H / 2), 0.25, 0.5, 1.05); comp.addPass(bloom);
  comp.addPass(new OutputPass());
  const GU = { tDiffuse: { value: null }, uAmt: { value: 1 } };
  comp.addPass(new ShaderPass(new THREE.ShaderMaterial({ uniforms: GU,
    vertexShader: "varying vec2 vUv;void main(){vUv=uv;gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}",
    fragmentShader: `uniform sampler2D tDiffuse;uniform float uAmt;varying vec2 vUv;void main(){vec3 c=texture2D(tDiffuse,vUv).rgb;float l=dot(c,vec3(.2126,.7152,.0722));
      c+=vec3(-.025,.03,.05)*(1.-smoothstep(0.,.45,l))*uAmt+vec3(.05,.015,-.035)*smoothstep(.4,1.,l)*uAmt;
      c=mix(vec3(l),c,1.1);c=c*c*(3.-2.*c)*.18+c*.82;gl_FragColor=vec4(clamp(c,0.,1.),1.);}` })));

  // ---------- timing helpers ----------
  const fallY = (t) => { const u = clamp01((t - (E.cebur + 0.2)) / 2.1); return -38.08 * (u * u * (1.6 - 0.6 * u)); };
  const landT = E.cebur + 2.3;
  const RY = (t) => (t < E.cebur ? 0 : fallY(t));
  const openShell = (t) => Math.max(bell(t, s.s5, s.s5 + 1.0, E.cang - 0.1, E.cang + 0.7), ramp(t, E.dibaca - 0.4, E.dibaca + 0.4));
  const openIns = (t) => Math.max(bell(t, s.s5 + 0.2, s.s5 + 1.2, E.ins - 0.1, E.ins + 0.7), ramp(t, E.dibaca - 0.3, E.dibaca + 0.5));
  const openTh = (t) => Math.max(bell(t, s.s5 + 0.4, s.s5 + 1.4, E.blok - 0.1, E.blok + 0.6), ramp(t, E.dibaca - 0.2, E.dibaca + 0.6));
  const chOff = (t) => eout(ramp(t, s.s5 - 0.1, s.s5 + 0.9)) * (1 - ramp(t, E.warna - 0.1, E.warna + 0.9));
  const r2In = (t) => eout(ramp(t, E.dua - 0.2, E.dua + 0.7)) * (1 - ramp(t, s.s4 - 0.1, s.s4 + 0.8));
  const sub = (s0, e0) => (t) => t >= s0 && t < e0;

  // camera: target + spherical [tx,ty,tz, az, el, logD] on a continuous spline
  const L = Math.log;
  const camK = trackM([
    [0, -0.4, 0.15, 0, -0.5, 0.17, L(13.2)],
    [E.oranye, -0.4, 0.15, 0, -0.25, 0.18, L(12.6)],
    [s.s1e, -0.4, 0.2, 0, 0.3, 0.2, L(12.4)],
    [s.s2 + 2.4, -2, 3, 0, 0.4, 0.15, L(40)],
    [E.florida, -4, 13, 0, 0.32, 0.1, L(150)],
    [s.s2e, -6, 18, 0, 0.38, 0.08, L(210)],
    [s.s3 + 1.0, -3.2, 0.9, -1.3, 0.6, 0.28, L(26)],
    [E.param, -3.5, 0.9, -1.3, 0.52, 0.27, L(21)],
    [E.suara, -2.0, 0.4, -1.4, 0.45, 0.26, L(16)],
    [s.s3e, -0.8, 0.2, -1.1, 0.42, 0.3, L(15)],
    [s.s4 + 1.4, -0.3, -0.1, 0, 0.25, 0.5, L(14)],
    [E.jam, -0.3, -0.1, 0, -0.3, 0.46, L(14.5)],
    [E.kedua, -0.3, 0.2, 0, -0.25, 0.42, L(17)],
    [E.ekor + 0.3, -8, 18, 0, 0.42, 0.1, L(205)],
    [s.s4e - 0.5, -14, 16, 0, 0.5, 0.14, L(225)],
    [s.s5 + 1.0, -1.3, -0.6, 0, -0.35, 0.2, L(13.5)],
    [E.cang, -1.3, -0.55, 0, -0.55, 0.2, L(13.2)],
    [s.s5e, -1.3, -0.6, 0, -0.25, 0.2, L(11)],
    [E.hit, -0.9, -0.4, 0, -0.12, 0.16, L(10.5)],
    [E.api + 1.2, -1.3, -0.1, 0, 0.25, 0.12, L(11)],
    [E.tek + 1.4, -1.3, 0.1, 0, 0.0, 0.2, L(12.5)],
    [E.warna + 1.2, -0.3, -0.3, 0, 0.45, 0.48, L(16.5)],
    [s.s6e, -0.3, -0.4, 0, 0.55, 0.52, L(16)],
    [E.cebur + 1.0, -0.3, -4, 0, 0.5, 0.25, L(14)],
    [landT, -0.3, -37.4, 0, 0.32, 0.1, L(12.5)],
    [E.sekali + 1.0, -0.6, -37.2, 0, 0.0, 0.12, L(15)],
    [E.sekali + 5.0, -0.6, -35.5, 0, -0.45, 0.22, L(40)],
    [E.aturan, -0.6, -35, 0, -0.6, 0.22, L(50)],
    [s.s7e, -0.6, -36, 0, -0.4, 0.15, L(24)],
    [E.dibaca, -0.3, -35.2, 1.0, -0.12, 0.1, L(11.5)],
    [E.disusun, -0.1, -35.1, 1.2, 0.06, 0.08, L(10.4)],
    [s.dur, 0, -35.0, 1.2, 0.14, 0.08, L(10.0)],
  ]);
  const tgt = new THREE.Vector3();
  const col3 = (k, i) => pc[k][i];
  const mixPal = (wts) => { for (let i = 0; i < 3; i++) { const c = new THREE.Color(0, 0, 0); let sw = 0; for (const k in wts) { c.r += col3(k, i).r * wts[k]; c.g += col3(k, i).g * wts[k]; c.b += col3(k, i).b * wts[k]; sw += wts[k]; } c.multiplyScalar(1 / Math.max(sw, 1e-4)); [BG.a, BG.b, BG.c][i].value.copy(c); } };
  const dm = new THREE.Object3D();
  const wp = new THREE.Vector3();

  return function draw(t) {
    if (!(t >= 0)) t = 0;
    // ---- recorder placement and paint ----
    const ry = RY(t);
    REC.R.position.set(0, ry, 0);
    uWipe.value = lerp(-5, 6, eout(ramp(t, E.oranye - 0.35, E.oranye + 0.9)));
    uEdge.value = bell(t, E.oranye - 0.4, E.oranye - 0.1, E.oranye + 0.7, E.oranye + 1.1);
    const stripe = bell(t, E.oranye + 0.2, E.oranye + 0.5, E.oranye + 1.2, E.oranye + 2.4) + 1.6 * bell(t, E.warna + 0.8, E.warna + 1.3, E.puing + 0.2, E.puing + 0.9);
    reflect.emissiveIntensity = 0.5 * stripe;
    const co = chOff(t);
    P.chassis.position.set(0.9 + 8 * co, CY - 0.3 * co, 0);
    P.pinger.position.set(CX - CL - 0.42 - 6 * co, CY - 0.05, 0);
    const es = eout(openShell(t)), ei = eout(openIns(t)), et = eout(openTh(t));
    P.shT.position.set(0, 1.25 * es, 0.25 * es); P.shT.rotation.x = -0.25 * es;
    P.shB.position.set(0, -1.15 * es, 0.25 * es); P.shB.rotation.x = 0.25 * es;
    P.inT.position.set(0, 0.75 * ei, 0.12 * ei); P.inB.position.set(0, -0.7 * ei, 0.12 * ei);
    P.thA.position.set(-0.3 - 1.0 * et, 0, 0); P.thB.position.set(0.3 + 1.0 * et, 0, 0);
    const br = eout(ramp(t, E.dibaca + 0.1, E.dibaca + 1.2));
    P.board.position.set(lerp(0, 0.7, br), lerp(0, 3.68, br), lerp(0, 1.6, br));
    P.board.rotation.set(lerp(0, 1.1, br), lerp(0, 0.2, br), 0);
    P.board.scale.setScalar(lerp(1, 1.5, br));
    pcbM.emissiveIntensity = 0.7 * bell(t, E.chip - 0.2, E.chip + 0.3, E.blok, E.blok + 0.5) + 0.9 * ramp(t, E.dibaca + 0.6, E.dibaca + 1.4);
    // ram, fire, chamber act on the module only (chassis is away)
    const ramX = t < E.hit ? lerp(12, 0, Math.pow(ramp(t, E.hit - 0.75, E.hit), 2.2)) : lerp(0, 1.4, eout(ramp(t, E.hit, E.hit + 0.5))) + 12 * ramp(t, E.api - 0.6, E.api + 0.2);
    ram.position.set(CX + CL + 0.02 + ramX, CY, 0); ram.visible = t > E.hit - 1 && t < E.api + 0.4;
    const recoil = t > E.hit ? 0.22 * Math.exp(-(t - E.hit) * 6) * Math.cos((t - E.hit) * 30) : 0;
    P.C.position.set(CX - Math.max(0, recoil), CY, 0);
    const wa = t - E.hit;
    wave.visible = wa > 0 && wa < 0.7; wave.position.set(CX + CL + 0.05, CY, 0); wave.scale.setScalar(0.3 + wa * 3); wave.material.opacity = 1 - wa / 0.7;
    for (let i = 0; i < SPARK.n; i++) { const dt = t - E.hit; const on = dt > 0 && dt < 0.9; const v = SD[i];
      SPARK.P[i * 3] = CX + CL + v.x * dt; SPARK.P[i * 3 + 1] = CY + v.y * dt - 4.9 * dt * dt; SPARK.P[i * 3 + 2] = v.z * dt; SPARK.Z[i] = 0.03; SPARK.A[i] = on ? 1 - dt / 0.9 : 0; }
    const fOn = bell(t, E.api - 0.3, E.api + 0.4, E.tek - 0.4, E.tek + 0.2);
    for (let i = 0; i < FIRE.n; i++) { const d = FD[i]; const age = ((t / d.per + d.ph) % 1);
      const rr = 0.66 + 0.25 * age; FIRE.P[i * 3] = d.x + 0.15 * Math.sin(t * 3 + d.w); FIRE.P[i * 3 + 1] = CY - 0.8 + age * 2.6 + Math.sin(d.a) * rr * (1 - age) * 0.6; FIRE.P[i * 3 + 2] = Math.cos(d.a) * rr * (1 - age * 0.6) + 0.1 * Math.sin(t * 5 + d.w);
      FIRE.Z[i] = (0.12 + 0.28 * Math.sin(Math.PI * age)) * (fOn > 0 ? 1 : 0); FIRE.A[i] = fOn * 0.22 * (1 - age); FIRE.Hc[i] = age; }
    fireL.intensity = fOn * (14 + 4 * Math.sin(t * 23) + 3 * Math.sin(t * 37)); fireL.position.set(CX, CY + 0.6, 0.8);
    const chDown = eout(ramp(t, E.tek - 0.35, E.tek + 0.45)) * (1 - eout(ramp(t, E.warna - 0.2, E.warna + 0.7)));
    cham.visible = chDown > 0.001; cham.position.set(CX, CY + 0.78 + 9 * (1 - chDown), 0);
    const fl = ramp(t, E.tek + 0.4, E.tek + 1.6) * (1 - ramp(t, E.warna - 0.4, E.warna));
    fill.scale.set(1, Math.max(0.001, 3.3 * fl), 1); fill.position.y = -1.65 + 1.65 * fl; fill.visible = fl > 0.002;
    for (let i = 0; i < BUB.n; i++) { const d = BD[i]; const age = (t * d.sp * 0.5 + d.ph) % 1; BUB.P[i * 3] = CX + Math.cos(d.a) * d.r; BUB.P[i * 3 + 1] = CY + 0.78 - 1.6 + age * 3.2 * fl; BUB.P[i * 3 + 2] = Math.sin(d.a) * d.r; BUB.Z[i] = d.sz; BUB.A[i] = cham.visible ? fl * 0.9 : 0; }
    // debris and search light
    const dIn = eout(ramp(t, E.warna - 0.2, E.warna + 1.0));
    const dbVis = t > E.warna - 0.3 && t < E.cebur + 2.5;
    deb.forEach((d, i) => { d.m.visible = dbVis; if (!dbVis) return; const sink = t > E.cebur ? fallY(t) * (0.3 + d.d) * 0.4 : 0; const k = 1 + 2.2 * (1 - dIn);
      d.m.position.set(-0.3 + (d.x + 0.3) * k, FLOORY + 0.08 + 1.5 * (1 - dIn) * Math.sin(i) * 0 + sink, d.z * k); d.m.rotation.set(d.rx + (1 - dIn) * 3, d.ry + (1 - dIn) * 4, 0); });
    const dark = bell(t, E.warna - 0.2, E.warna + 0.8, E.cebur - 0.3, E.cebur + 0.4);
    flash.intensity = 60 * dark; const fa = (t - E.warna) * 0.55 - 0.8;
    flash.position.set(-0.3 + Math.sin(fa) * 7, 9, 6 + Math.cos(fa) * 2); flash.target.position.set(-0.3 + Math.sin(fa * 1.3) * 1.2, -0.5, 0);
    // ---- environment weights ----
    const wVoid = bell(t, s.s2 - 0.2, s.s2 + 2.2, s.s5 - 0.2, s.s5 + 1.1);
    const wSea = ramp(t, E.cebur + 0.6, E.cebur + 1.4) * (1 - ramp(t, E.lab - 0.5, E.lab + 0.9));
    const wLab = ramp(t, E.lab - 0.5, E.lab + 0.9);
    const wDark = dark * (1 - wSea);
    const wStudio = Math.max(0, 1 - wVoid - wSea - wLab - wDark);
    mixPal({ studio: wStudio + 1e-4, void: wVoid, dark: wDark, sea: wSea, lab: wLab });
    S.fog.color.copy(BG.b.value);
    S.fog.density = 0.006 * (wStudio + wDark) + 0.0012 * wVoid + 0.013 * wSea + 0.02 * wLab;
    floorM.opacity = (1 - wVoid) * (1 - ramp(t, E.cebur - 0.2, E.cebur + 0.6)); floor.visible = floorM.opacity > 0.01;
    aoM.opacity = floorM.opacity * (t < E.cebur ? 1 : 0); ao.visible = aoM.opacity > 0.01;
    const wOn = ramp(t, E.cebur - 0.3, E.cebur + 0.4) * (1 - ramp(t, E.lab - 0.4, E.lab + 0.6));
    WU.uA.value = wOn; WU.uT.value = t; WU.uR.value = Math.max(0, (t - E.cebur - 0.2)) * 5; WU.uRa.value = (t > E.cebur + 0.2 ? Math.exp(-(t - E.cebur - 0.2) * 0.7) : 0); WU.uCam.value.copy(cam.position);
    water.visible = wOn > 0.01;
    // ghost plane
    plane.visible = wVoid > 0.01;
    const scan = lerp(70, -380, ramp(t, s.s2 + 0.6, s.s2 + 5.5));
    ghM.uniforms.uScan.value = ghF.uniforms.uScan.value = ghP.uniforms.uScan.value = scan; ghP.uniforms.uA.value = wVoid * 0.6;
    ghM.uniforms.uA.value = wVoid * 0.6; ghF.uniforms.uA.value = wVoid * 0.35;
    const hi = bell(t, E.ekor - 0.6, E.ekor, s.s4e - 0.4, s.s4e + 0.5);
    ghM.uniforms.uHi.value = ghF.uniforms.uHi.value = ghP.uniforms.uHi.value = hi;
    tailGlow.visible = wVoid > 0.01; tailGlow.material.opacity = wVoid * (0.35 + 0.65 * Math.max(hi, bell(t, s.s2 + 2, s.s2 + 4, s.s3, s.s3 + 1)));
    { const d = tailGlow.position.distanceTo(cam.position); tailGlow.scale.setScalar(d * 0.09 * (1 + 0.15 * Math.sin(t * 6))); }
    // second recorder (voice) in the tail bay
    const r2 = r2In(t); REC2.R.visible = r2 > 0.001; REC2.R.position.set(0.3 + 10 * (1 - r2), 0, R2Z);
    // data river
    river.visible = t > s.s3 - 0.2 && t < s.s4 + 1;
    riverM.uniforms.uT.value = t; riverM.uniforms.uA.value = bell(t, s.s3 + 0.4, E.dua + 1.6, s.s3e, s.s4 + 0.8) * (0.5 + 0.6 * bell(t, E.param - 0.2, E.param + 0.3, E.suara - 0.5, E.suara + 0.5));
    riverM.uniforms.uG.value = ramp(t, s.s3 + 0.5, E.param + 0.4);
    const bOn = bell(t, E.suara - 0.4, E.suara + 0.3, s.s3e, s.s4 + 0.6);
    bars.visible = bOn > 0.001;
    for (let i = 0; i < NB; i++) { const u = i / NB; const x = -16 + u * 15.2; const ph = x * 1.7 - t * 9;
      const amp = (0.25 + 0.75 * Math.abs(Math.sin(ph) * Math.sin(ph * 0.37 + 1.3))) * (0.4 + 0.6 * u) * bOn + 0.0001;
      const alarm = bell(t, E.alarm - 0.2, E.alarm, E.alarm + 0.6, E.alarm + 1.0) * (Math.sin(t * 40) > 0 ? 0.5 : 0);
      dm.position.set(x, 1.1, R2Z); dm.rotation.set(0, 0, 0); dm.scale.set(1, (amp + alarm) * 1.4, 1); dm.updateMatrix(); bars.setMatrixAt(i, dm.matrix); }
    bars.instanceMatrix.needsUpdate = true;
    // loop ring
    const rOn = t > s.s4 - 0.3 && t < E.kedua + 1.4; ring.visible = head.visible = rOn;
    if (rOn) {
      const hd = (t - s.s4) * 1.7, tc = new THREE.Color();
      const ovw = 1 + 1.4 * bell(t, E.timpa - 0.3, E.timpa, E.timpa + 1.8, E.timpa + 2.4);
      for (let i = 0; i < NR; i++) {
        const a = (i / NR) * Math.PI * 2;
        const pop = eout(ramp(t, s.s4 - 0.2 + i * 0.012, s.s4 + 0.3 + i * 0.012)) * (1 - ramp(t, E.kedua + 0.1 + i * 0.008, E.kedua + 0.5 + i * 0.008));
        const age = (((hd - a) % (Math.PI * 2)) + Math.PI * 2) % (Math.PI * 2) / (Math.PI * 2);
        dm.position.set(-0.3 + Math.cos(a) * 3.3, 0.2, Math.sin(a) * 3.3); dm.rotation.set(0, -a, 0); dm.scale.setScalar(Math.max(0.001, pop) * (age < 0.04 ? 1.35 : 1)); dm.updateMatrix(); ring.setMatrixAt(i, dm.matrix);
        if (age > 0.94) tc.setRGB(2.6 * ovw, 0.35, 0.25); else if (age < 0.04) tc.setRGB(3, 3, 3); else { const f = 1 - age; tc.setRGB(0.15 + 0.4 * f * f, 0.5 + 1.8 * f * f, 0.6 + 2.0 * f * f); }
        ring.setColorAt(i, tc);
      }
      ring.instanceMatrix.needsUpdate = true; ring.instanceColor.needsUpdate = true;
      head.position.set(-0.3 + Math.cos(hd) * 3.3, 0.6, Math.sin(hd) * 3.3); head.rotation.set(Math.PI, 0, 0); head.scale.setScalar(eout(ramp(t, s.s4, s.s4 + 0.5)) * (1 - ramp(t, E.kedua, E.kedua + 0.5)) + 0.001);
    }
    // ---- sea ----
    const seaVis = t > E.cebur - 0.2;
    sand.visible = rocks.visible = shafts.visible = seaVis;
    sandM.opacity = 1 - ramp(t, E.lab - 0.3, E.lab + 0.9); causTex.offset.set(t * 0.02, t * 0.013);
    shaftM.uniforms.uA.value = wSea; shafts.children.forEach((m, i) => { m.rotation.z = 0.12 * Math.sin(t * 0.3 + i); });
    for (let i = 0; i < SNOW.n; i++) { const b = ND[i]; SNOW.P[i * 3] = b.x + Math.sin(t * 0.3 + i) * 0.4; SNOW.P[i * 3 + 1] = SEAY + ((b.y - t * 0.35) % 40 + 40) % 40; SNOW.P[i * 3 + 2] = b.z; SNOW.Z[i] = 0.025; SNOW.A[i] = wSea * 0.55; }
    for (let i = 0; i < TRAIL.n; i++) { const d = TD[i]; const te = E.cebur + 0.25 + d.te * 2.4; const dt = t - te; const on = dt > 0 && dt < 3;
      const y0 = fallY(te) - 0.2; TRAIL.P[i * 3] = -0.6 + d.dx + 0.15 * Math.sin(dt * 5 + d.w); TRAIL.P[i * 3 + 1] = y0 + dt * 2.2; TRAIL.P[i * 3 + 2] = d.dz; TRAIL.Z[i] = d.sz; TRAIL.A[i] = on && TRAIL.P[i * 3 + 1] < FLOORY ? 0.8 * (1 - dt / 3) : 0; }
    for (let i = 0; i < PUFF.n; i++) { const d = PD[i]; const dt = t - landT; const on = dt > 0 && dt < 4; const rr = d.v * (1 - Math.exp(-dt * 1.2));
      PUFF.P[i * 3] = -0.3 + Math.cos(d.a) * rr * 1.4; PUFF.P[i * 3 + 1] = SEAY + 0.3 + d.h * (1 - Math.exp(-dt)); PUFF.P[i * 3 + 2] = Math.sin(d.a) * rr; PUFF.Z[i] = d.sz * (0.5 + dt * 0.4); PUFF.A[i] = on ? 0.18 * (1 - dt / 4) * wSea : 0; }
    // pinger pulses: one per second from "Sekali"
    P.pinger.getWorldPosition(wp); wp.x -= 0.43;
    const pOn = t > E.pinger + 0.4 && t < E.lab + 1.2;
    let blink = 0;
    for (let i = 0; i < 4; i++) {
      const n0 = Math.floor(t - E.sekali);
      let best = -1, age = 9;
      for (let n = n0 - 3; n <= n0; n++) if (((n % 4) + 4) % 4 === i) { const a = t - (E.sekali + n); if (a >= 0 && a < age && E.sekali + n < E.lab + 0.6) { age = a; best = n; } }
      const vis = best >= 0 && age < 3.6 && t > E.sekali;
      shells[i].m.visible = shells[i].gr.visible = vis;
      if (vis) { const rad = 0.2 + age * 9; shells[i].m.position.copy(wp); shells[i].m.scale.setScalar(rad); shellU[i].uA.value = Math.pow(1 - age / 3.6, 1.6) * (wSea + 0.2);
        shells[i].gr.position.set(wp.x, SEAY + 0.45, wp.z); shells[i].gr.scale.setScalar(rad); shells[i].gr.material.opacity = Math.pow(1 - age / 3.6, 2) * 0.8; }
      if (vis && age < 0.25) blink = Math.max(blink, 1 - age / 0.25);
    }
    const ledOn = pOn ? 0.25 + 0.75 * blink + 0.6 * bell(t, E.pinger + 0.3, E.pinger + 0.6, E.pinger + 1.2, E.pinger + 1.6) : 0;
    P.led.material.color.setRGB(0.4 + 4 * ledOn, 0.4 + 9 * ledOn, 0.4 + 10 * ledOn);
    pingL.intensity = 18 * ledOn; pingL.position.copy(wp);
    // ---- lab ----
    gridM.uniforms.uA.value = wLab; grid.visible = wLab > 0.01;
    lab.visible = t > E.lab;
    const gr = (k) => ramp(t, E.dibaca + 0.9 + k * 0.35, E.disusun + 1.6 + k * 0.3);
    traces.forEach((m, k) => { m.material.uniforms.uG.value = gr(k); m.material.uniforms.uA.value = wLab; m.material.uniforms.uT.value = t; });
    lab.children.forEach((m) => { if (m.material && m.material.opacity !== undefined && !m.material.uniforms) m.material.opacity = (m === hdr ? 1 : 0.6) * ramp(t, E.dibaca + 0.4, E.dibaca + 1.2); });
    const pg = ramp(t, E.disusun - 0.6, s.dur - 1.6);
    pathM.uniforms.uG.value = pg; pathM.uniforms.uA.value = wLab * 0.8; pathM.uniforms.uT.value = t;
    mini.visible = t > E.disusun - 0.6;
    miniP.uniforms.uA.value = miniM.uniforms.uA.value = miniF.uniforms.uA.value = 2.2 * ramp(t, E.disusun - 0.6, E.disusun);
    miniP.uniforms.uScan.value = miniM.uniforms.uScan.value = miniF.uniforms.uScan.value = -999;
    { const u = Math.min(0.999, Math.max(0.001, pg)); const p = pathCurve.getPointAt(u), d = pathCurve.getTangentAt(u); mini.position.copy(p); mini.lookAt(p.clone().sub(d)); mini.rotateY(-Math.PI / 2); }
    // ---- lights follow the recorder ----
    const rc = v3(-0.3, ry, 0);
    key.position.set(rc.x + 6, rc.y + 10, rc.z + 8); key.target.position.copy(rc);
    key.intensity = 2.6 * (1 - 0.8 * dark) * (1 - 0.45 * wSea) * (1 - 0.3 * wLab);
    key.color.setRGB(1, lerp(0.89, 1.0, wSea), lerp(0.77, 0.95, wSea));
    rimT.position.set(rc.x - 8, rc.y + 5, -7); rimT.intensity = 1.7 * (1 - 0.5 * dark) + 1.2 * wSea;
    rimO.position.set(rc.x + 9, rc.y + 2, -5); rimO.intensity = 0.9 * (1 - wSea);
    hemi.intensity = 0.35 * (1 - 0.7 * dark) + 0.25 * wSea;
    // ---- camera ----
    const c = camK(t);
    tgt.set(c[0], c[1], c[2]);
    const tf = bell(t, E.cebur + 0.1, E.cebur + 0.4, landT - 0.2, landT + 0.2);
    if (tf > 0) tgt.y = lerp(tgt.y, ry + 0.1, tf);
    const D = Math.exp(c[5]);
    cam.position.set(tgt.x + D * Math.cos(c[4]) * Math.sin(c[3]), tgt.y + D * Math.sin(c[4]), tgt.z + D * Math.cos(c[4]) * Math.cos(c[3]));
    if (t > E.hit && t < E.hit + 0.8) { const k = (1 - (t - E.hit) / 0.8) * 0.18; cam.position.x += k * Math.sin(t * 91); cam.position.y += k * Math.sin(t * 73 + 1); }
    cam.lookAt(tgt);
    cam.updateMatrixWorld();
    // ---- labels ----
    REC.R.updateMatrixWorld(true); REC2.R.updateMatrixWorld(true);
    const pos = (o, x = 0, y = 0, z = 0) => o.localToWorld(v3(x, y, z));
    setLabel(LB.fdr, pos(P.chassis, 0, 0.7, 0), v3(-1.8, 1.0, 1.2), bell(t, E.dua + 0.6, E.dua + 1.0, s.s3e - 0.3, s.s3e + 0.2));
    setLabel(LB.cvr, pos(REC2.parts.chassis, 0, 0.7, 0), v3(1.3, 2.4, -0.2), bell(t, E.suara - 0.2, E.suara + 0.2, s.s3e - 0.3, s.s3e + 0.2));
    setLabel(LB.chip, pos(P.board, -0.3, 0.03, 0.1), v3(-1.9, 0.5, 0.6), bell(t, E.chip - 0.1, E.chip + 0.3, E.inilah - 0.3, E.inilah));
    setLabel(LB.blok, pos(P.thA, -0.2, 0.15, 0.2), v3(-1.3, -1.5, 0.8), bell(t, E.blok - 0.1, E.blok + 0.3, E.inilah - 0.3, E.inilah));
    setLabel(LB.ins, pos(P.inT, -0.3, 0.45, 0.3), v3(-1.6, 1.3, 0.5), bell(t, E.ins - 0.1, E.ins + 0.3, E.inilah - 0.3, E.inilah));
    setLabel(LB.cang, pos(P.shT, 0.3, 0.6, 0.2), v3(1.1, 1.9, 0.5), bell(t, E.cang - 0.1, E.cang + 0.3, E.inilah - 0.3, E.inilah));
    setLabel(LB.csmu, pos(P.C, 0, 0.62, 0.2), v3(0.3, 2.0, 0.6), bell(t, E.inilah + 0.1, E.inilah + 0.5, s.s5e, s.s5e + 0.4));
    setLabel(LB.ping, wp.clone(), v3(-0.9, 1.6, 0.6), bell(t, landT + 0.1, landT + 0.5, E.sekali + 2.2, E.sekali + 2.7));
    setLabel(LB.ekor, v3(-0.3, 0, 0), v3(-14, 26, 6), bell(t, E.ekor - 0.1, E.ekor + 0.4, s.s4e - 0.2, s.s4e + 0.3));
    FIRE.g.attributes.position.needsUpdate = FIRE.g.attributes.sz.needsUpdate = FIRE.g.attributes.al.needsUpdate = FIRE.g.attributes.hc.needsUpdate = true;
    for (const Q of [SPARK, BUB, SNOW, TRAIL, PUFF]) { Q.g.attributes.position.needsUpdate = Q.g.attributes.sz.needsUpdate = Q.g.attributes.al.needsUpdate = true; }
    bloom.strength = 0.22 + 0.12 * wVoid + 0.18 * wSea + 0.15 * wLab;
    comp.render();
  };
}
