// EP11 KOTAK HITAM. INNERWORKS cutaway: an orange flight recorder (generic, illustration) in a teal-graphite studio.
// One connected world around the recorder at the origin: ghost airliner tail (s2-s4), exploded memory module (s5),
// torture rig (s6), the studio floor turning into sea water (s7), and a lab readout on the sea floor (s8).
// 1 unit = 10 cm. Every value is a pure function of t.
import * as THREE from "./three.module.js";
import { EffectComposer } from "./EffectComposer.js";
import { RenderPass } from "./RenderPass.js";
import { UnrealBloomPass } from "./UnrealBloomPass.js";
import { ShaderPass } from "./ShaderPass.js";
import { OutputPass } from "./OutputPass.js";
import { RoomEnvironment } from "./RoomEnvironment.js";
import { mulberry, ramp, clamp01, canvasTex, eout, std } from "./lib3d.js";

const W = 1080, H = 1920;
const v3 = (x, y, z) => new THREE.Vector3(x, y, z);
const lerp = (a, b, u) => a + (b - a) * u;
const bell = (t, a, b, c, d) => ramp(t, a, b) * (1 - ramp(t, c, d));

function rrect(w, h, r) {
  const s = new THREE.Shape(), x = -w / 2, y = -h / 2;
  s.moveTo(x + r, y); s.lineTo(x + w - r, y); s.absarc(x + w - r, y + r, r, -Math.PI / 2, 0);
  s.lineTo(x + w, y + h - r); s.absarc(x + w - r, y + h - r, r, 0, Math.PI / 2);
  s.lineTo(x + r, y + h); s.absarc(x + r, y + h - r, r, Math.PI / 2, Math.PI);
  s.lineTo(x, y + r); s.absarc(x + r, y + r, r, Math.PI, 1.5 * Math.PI);
  return s;
}
// rounded box centred on the origin, w along x, h along y, d along z
function rbox(w, h, d, b) {
  const g = new THREE.ExtrudeGeometry(rrect(w - 2 * b, h - 2 * b, b * 0.6), { depth: d - 2 * b, bevelEnabled: true, bevelSize: b, bevelThickness: b, bevelSegments: 4, curveSegments: 6 });
  g.translate(0, 0, -(d - 2 * b) / 2);
  return g;
}
// half of a lathe solid (profile [r, y]) with its axis turned to x; top=true gives the y>0 half
function halfLathe(profile, top, seg = 40) {
  const g = new THREE.LatheGeometry(profile.map(([r, y]) => new THREE.Vector2(r, y)), seg, top ? Math.PI : 0, Math.PI);
  g.rotateZ(-Math.PI / 2);
  return g;
}
const mesh = (g, m, parent, x = 0, y = 0, z = 0) => { const o = new THREE.Mesh(g, m); o.position.set(x, y, z); o.castShadow = o.receiveShadow = true; if (parent) parent.add(o); return o; };

// monotone cubic (PCHIP) per channel: no overshoot on big dolly moves. keys: [t, ...values]
function trackM(keys) {
  const n = keys.length, m = keys[0].length;
  const tan = keys.map(() => new Array(m).fill(0));
  for (let j = 1; j < m; j++) for (let i = 0; i < n; i++) {
    const dl = i > 0 ? (keys[i][j] - keys[i - 1][j]) / (keys[i][0] - keys[i - 1][0]) : null;
    const dr = i < n - 1 ? (keys[i + 1][j] - keys[i][j]) / (keys[i + 1][0] - keys[i][0]) : null;
    if (dl === null || dr === null) tan[i][j] = 0;
    else if (dl * dr <= 0) tan[i][j] = 0;
    else tan[i][j] = 2 / (1 / dl + 1 / dr);
  }
  return (t) => {
    if (t <= keys[0][0]) return keys[0].slice(1);
    if (t >= keys[n - 1][0]) return keys[n - 1].slice(1);
    let i = 0; while (keys[i + 1][0] < t) i++;
    const k0 = keys[i], k1 = keys[i + 1], h = k1[0] - k0[0], u = (t - k0[0]) / h, u2 = u * u, u3 = u2 * u;
    const out = [];
    for (let j = 1; j < m; j++) out.push((2 * u3 - 3 * u2 + 1) * k0[j] + (u3 - 2 * u2 + u) * h * tan[i][j] + (-2 * u3 + 3 * u2) * k1[j] + (u3 - u2) * h * tan[i + 1][j]);
    return out;
  };
}

export function create(canvas, K, AT) {
  const r = new THREE.WebGLRenderer({ canvas, antialias: false, preserveDrawingBuffer: true, powerPreference: "high-performance" });
  r.setSize(W, H, false);
  r.toneMapping = THREE.ACESFilmicToneMapping;
  r.toneMappingExposure = 1.0;
  r.shadowMap.enabled = true;
  r.shadowMap.type = THREE.PCFSoftShadowMap;
  const cam = new THREE.PerspectiveCamera(38, W / H, 0.1, 9000);
  const s = K;
  const A_ = (k, d) => (AT[k] !== undefined ? AT[k] : d);
  const E = {
    oranye: A_("s1:oranye", 2.3),
    penyelam: A_("s2:penyelam", s.s2 + 0.9), florida: A_("s2:Florida", s.s2 + 8),
    dua: A_("s3:dua", s.s3 + 0.3), param: A_("s3:parameter", s.s3 + 4), suara: A_("s3:suara", s.s3 + 7.7), alarm: A_("s3:alarm", s.s3 + 10),
    rek: A_("s4:Rekamannya", s.s4), timpa: A_("s4:ditimpa", s.s4 + 2), jam: A_("s4:jam", s.s4 + 6.6), kedua: A_("s4:Keduanya", s.s4 + 7.8), ekor: A_("s4:ekor", s.s4 + 9.5),
    chip: A_("s5:chip", s.s5 + 1), blok: A_("s5:blok", s.s5 + 3), ins: A_("s5:insulasi", s.s5 + 3.9), cang: A_("s5:cangkang", s.s5 + 5.7), inilah: A_("s5:Inilah", s.s5 + 7.5),
    hit: A_("s6:benturan", s.s6 + 1) + 0.55, api: A_("s6:api", s.s6 + 4), tek: A_("s6:tekanan", s.s6 + 7.2), warna: A_("s6:Warnanya", s.s6 + 10), puing: A_("s6:puing", s.s6 + 13),
    cebur: A_("s7:tercebur", s.s7 + 0.5), pinger: A_("s7:pinger", s.s7 + 1.2), sekali: A_("s7:Sekali", s.s7 + 3.1), aturan: A_("s7:Aturan", s.s7 + 11.8),
    lab: A_("s8:laboratorium", s.s8 + 0.3), dibaca: A_("s8:dibaca", s.s8 + 1.6), disusun: A_("s8:disusun", s.s8 + 4),
  };
  const rnd = mulberry(1111);

  const S = new THREE.Scene();
  S.fog = new THREE.FogExp2(0x1d2a30, 0.006);
  const pm = new THREE.PMREMGenerator(r);
  S.environment = pm.fromScene(new RoomEnvironment(), 0.04).texture;
  S.environmentIntensity = 0.55;

  // ---------- background sphere (studio / void / sea / lab colours blend per frame) ----------
  const BG = { a: { value: new THREE.Color() }, b: { value: new THREE.Color() }, c: { value: new THREE.Color() } };
  const bg = new THREE.Mesh(new THREE.SphereGeometry(4000, 32, 16), new THREE.ShaderMaterial({
    side: THREE.BackSide, depthWrite: false, uniforms: BG,
    vertexShader: "varying vec3 v;void main(){v=normalize(position);gl_Position=projectionMatrix*modelViewMatrix*vec4(position,1.);}",
    fragmentShader: "varying vec3 v;uniform vec3 a,b,c;void main(){float y=normalize(v).y;vec3 k=y>0.?mix(b,a,pow(y,.6)):mix(b,c,pow(-y,.45));gl_FragColor=vec4(k,1.);}",
  }));
  S.add(bg);
  const PAL = {
    studio: [0x1b2c33, 0x2c3d43, 0x10181c], void: [0x050c14, 0x0c1d29, 0x04080c], dark: [0x080d10, 0x141c20, 0x050709],
    sea: [0x3aa0a8, 0x0e4f5a, 0x02161b], lab: [0x081520, 0x0f2430, 0x04090d],
  };
  const pc = {}; for (const k in PAL) pc[k] = PAL[k].map((x) => new THREE.Color(x));

  // ---------- lights ----------
  const key = new THREE.DirectionalLight(0xffe2c4, 2.6);
  key.castShadow = true; key.shadow.mapSize.set(2048, 2048); key.shadow.bias = -0.0005; key.shadow.normalBias = 0.03;
  Object.assign(key.shadow.camera, { left: -9, right: 9, top: 9, bottom: -9, near: 1, far: 60 });
  S.add(key, key.target);
  const rimT = new THREE.DirectionalLight(0x4fd6e6, 1.7); rimT.position.set(-8, 5, -7); S.add(rimT);
  const rimO = new THREE.DirectionalLight(0xff8a3d, 0.9); rimO.position.set(9, 2, -5); S.add(rimO);
  const hemi = new THREE.HemisphereLight(0x9fc4d0, 0x1a1410, 0.35); S.add(hemi);
  const fireL = new THREE.PointLight(0xff7a2a, 0, 14, 1.6); S.add(fireL);
  const flash = new THREE.SpotLight(0xfff3dc, 0, 40, 0.28, 0.6, 1.2); flash.castShadow = false; S.add(flash, flash.target);
  const pingL = new THREE.PointLight(0x5ff2ff, 0, 16, 1.5); S.add(pingL);

  // ---------- materials ----------
  const uWipe = { value: -20 }, uEdge = { value: 0 };
  const paint = new THREE.MeshPhysicalMaterial({ color: 0xff5e0e, roughness: 0.34, metalness: 0, clearcoat: 1, clearcoatRoughness: 0.1 });
  paint.onBeforeCompile = (sh) => {
    sh.uniforms.uWipe = uWipe; sh.uniforms.uEdge = uEdge;
    sh.vertexShader = sh.vertexShader.replace("#include <common>", "#include <common>\nvarying vec3 vWq;")
      .replace("#include <project_vertex>", "#include <project_vertex>\nvWq=(modelMatrix*vec4(transformed,1.)).xyz;");
    sh.fragmentShader = sh.fragmentShader.replace("#include <common>", "#include <common>\nvarying vec3 vWq;uniform float uWipe,uEdge;")
      .replace("#include <color_fragment>", "#include <color_fragment>\nfloat wq=vWq.x+.45*vWq.y;diffuseColor.rgb=mix(diffuseColor.rgb,vec3(.006),smoothstep(uWipe-.12,uWipe+.12,wq));")
      .replace("#include <emissivemap_fragment>", "#include <emissivemap_fragment>\ntotalEmissiveRadiance+=vec3(1.,.45,.12)*3.*uEdge*exp(-pow((vWq.x+.45*vWq.y-uWipe)*7.,2.));");
  };
  const chrome = new THREE.MeshStandardMaterial({ color: 0xe8ecef, roughness: 0.08, metalness: 1 });
  const steel = new THREE.MeshStandardMaterial({ color: 0xb9c0c6, roughness: 0.22, metalness: 1, side: THREE.DoubleSide });
  const darkMetal = new THREE.MeshStandardMaterial({ color: 0x23282c, roughness: 0.35, metalness: 0.85 });
  const reflect = new THREE.MeshStandardMaterial({ color: 0xc9d2d6, roughness: 0.35, metalness: 0.5, emissive: 0xffffff, emissiveIntensity: 0 });
  const insTex = canvasTex(512, 512, (c, w, h) => {
    c.fillStyle = "#e9e0cc"; c.fillRect(0, 0, w, h); const R = mulberry(4);
    for (let i = 0; i < 5000; i++) { c.strokeStyle = R() > 0.5 ? "rgba(150,135,110,.25)" : "rgba(255,255,255,.35)"; c.lineWidth = 1; const x = R() * w, y = R() * h, a = R() * 6.28; c.beginPath(); c.moveTo(x, y); c.lineTo(x + Math.cos(a) * 14, y + Math.sin(a) * 14); c.stroke(); }
  });
  const insul = new THREE.MeshStandardMaterial({ color: 0xcfc6b4, map: insTex, bumpMap: insTex, bumpScale: 2, roughness: 0.95, side: THREE.DoubleSide });
  const thermal = new THREE.MeshPhysicalMaterial({ color: 0x3b3f44, roughness: 0.55, metalness: 0.1, clearcoat: 0.4, clearcoatRoughness: 0.4 });
  const pcbTex = canvasTex(1024, 512, (c, w, h) => {
    c.fillStyle = "#0c5a3c"; c.fillRect(0, 0, w, h); const R = mulberry(9);
    c.strokeStyle = "#d9b45a"; c.lineWidth = 3;
    for (let i = 0; i < 70; i++) { let x = R() * w, y = R() * h; c.beginPath(); c.moveTo(x, y); for (let k = 0; k < 4; k++) { if (R() > 0.5) x += (R() - 0.5) * 300; else y += (R() - 0.5) * 200; c.lineTo(x, y); } c.stroke(); }
    c.fillStyle = "#e7c35e"; for (let i = 0; i < 40; i++) c.fillRect(30 + i * 24, h - 34, 14, 30);
    c.fillStyle = "#f2f2f2"; c.font = "bold 46px Arial"; c.fillText("AUDIRA  CSMU-11", 40, 64); c.font = "28px Arial"; c.fillText("ILUSTRASI  /  MEMORI SOLID-STATE", 40, 104);
  });
  const pcbM = new THREE.MeshStandardMaterial({ map: pcbTex, roughness: 0.45, metalness: 0.2, emissive: 0x36f0ff, emissiveIntensity: 0, emissiveMap: pcbTex });
  const chipM = new THREE.MeshStandardMaterial({ color: 0x111316, roughness: 0.3, metalness: 0.4 });

  // decal with the warning text on the chassis front
  const decal = canvasTex(1024, 512, (c, w, h) => {
    c.clearRect(0, 0, w, h); c.fillStyle = "#ffffff"; c.textAlign = "center";
    c.font = "bold 92px Arial"; c.fillText("PEREKAM PENERBANGAN", w / 2, 150);
    c.font = "bold 104px Arial"; c.fillText("JANGAN DIBUKA", w / 2, 280);
    c.font = "bold 46px Arial"; c.fillText("FLIGHT RECORDER  ·  DO NOT OPEN", w / 2, 380);
  });
  const decalM = new THREE.MeshStandardMaterial({ map: decal, transparent: true, roughness: 0.4, depthWrite: false, polygonOffset: true, polygonOffsetFactor: -2 });
  const plateTex = canvasTex(1024, 320, (c, w, h) => {
    const g = c.createLinearGradient(0, 0, w, h); g.addColorStop(0, "#c9ced2"); g.addColorStop(0.5, "#f4f6f7"); g.addColorStop(1, "#aeb4b9"); c.fillStyle = g; c.fillRect(0, 0, w, h);
    const R = mulberry(3); for (let i = 0; i < 900; i++) { c.fillStyle = R() > 0.5 ? "rgba(0,0,0,.05)" : "rgba(255,255,255,.12)"; c.fillRect(0, R() * h, w, 1); }
    c.fillStyle = "#14191d"; c.font = "bold 150px Arial"; c.textAlign = "center"; c.fillText("AUDIRA", w / 2, 170); c.font = "bold 44px Arial"; c.fillText("UNIT ILUSTRASI  ·  S/N 11-2026", w / 2, 260);
  });
  const plateM = new THREE.MeshStandardMaterial({ map: plateTex, roughness: 0.25, metalness: 0.9 });

  // ---------- recorder ----------
  const CX = -1.3, CY = -0.15, CL = 0.82; // memory-module cylinder centre, half length
  function buildRecorder(full) {
    const R = new THREE.Group();
    const parts = {};
    const tray = mesh(rbox(4.9, 0.12, 1.9, 0.04), darkMetal, R, -0.25, -0.86, 0);
    [[-2.4, 0.75], [-2.4, -0.75], [2.0, 0.75], [2.0, -0.75]].forEach(([x, z]) => mesh(new THREE.CylinderGeometry(0.09, 0.09, 0.1, 16), chrome, tray, x, 0.1, z));
    // chassis: interface electronics, slides away in s5
    const ch = new THREE.Group(); ch.position.set(0.9, CY, 0); R.add(ch); parts.chassis = ch;
    mesh(rbox(2.6, 1.3, 1.5, 0.12), paint, ch);
    for (let i = 0; i < 6; i++) mesh(rbox(2.2, 0.08, 0.1, 0.03), paint, ch, 0, 0.68, -0.55 + i * 0.22);
    [-0.85, 0.85].forEach((x) => mesh(rbox(0.16, 1.34, 1.54, 0.05), reflect, ch, x, 0, 0));
    const dm = new THREE.Mesh(new THREE.PlaneGeometry(1.5, 0.75), decalM); dm.position.set(0, 0.05, 0.752); ch.add(dm);
    const plate = mesh(rbox(1.2, 0.03, 0.38, 0.01), plateM, ch, 0.3, 0.66, 0.42);
    const pg = new THREE.Mesh(new THREE.PlaneGeometry(1.16, 0.36), plateM); pg.rotation.x = -Math.PI / 2; pg.position.set(0.3, 0.682, 0.42); ch.add(pg);
    plate.visible = false;
    mesh(new THREE.CylinderGeometry(0.28, 0.28, 0.3, 24), chrome, ch, 1.42, 0, 0).rotation.z = Math.PI / 2;
    mesh(new THREE.CylinderGeometry(0.2, 0.2, 0.34, 24), darkMetal, ch, 1.46, 0, 0).rotation.z = Math.PI / 2;
    // memory module (CSMU): saddle + nested layers
    const C = new THREE.Group(); C.position.set(CX, CY, 0); R.add(C); parts.C = C;
    mesh(rbox(1.2, 0.3, 1.2, 0.05), darkMetal, R, CX, -0.66, 0);
    const shellP = [[0, -CL], [0.62, -CL], [0.62, CL], [0, CL], [0, CL - 0.08], [0.54, CL - 0.08], [0.54, -CL + 0.08], [0, -CL + 0.08]];
    const skinP = [[0.6, -CL + 0.02], [0.63, -CL + 0.02], [0.63, CL - 0.02], [0.6, CL - 0.02]];
    const insP = [[0, -0.74], [0.53, -0.74], [0.53, 0.74], [0, 0.74], [0, 0.6], [0.4, 0.6], [0.4, -0.6], [0, -0.6]];
    const L = (top) => {
      const sh = new THREE.Group(); C.add(sh);
      mesh(halfLathe(shellP, top), steel, sh);
      mesh(halfLathe(skinP, top), paint, sh);
      [-0.38, 0.38].forEach((x) => { const b = mesh(halfLathe([[0.632, x - 0.07], [0.645, x - 0.07], [0.645, x + 0.07], [0.632, x + 0.07]], top), reflect, sh); });
      for (let k = 0; k < 4; k++) { const a = (top ? 0.4 : Math.PI + 0.4) + k * 0.75; const bo = mesh(new THREE.CylinderGeometry(0.05, 0.05, 0.06, 12), chrome, sh, -CL - 0.02, Math.cos(a) * 0.45, Math.sin(a) * 0.45); bo.rotation.z = Math.PI / 2; }
      const ins = mesh(halfLathe(insP, top), insul, C);
      return { sh, ins };
    };
    const up = L(true), dn = L(false);
    parts.shT = up.sh; parts.shB = dn.sh; parts.inT = up.ins; parts.inB = dn.ins;
    const thA = mesh(rbox(0.6, 0.54, 0.54, 0.06), thermal, C, -0.3, 0, 0), thB = mesh(rbox(0.6, 0.54, 0.54, 0.06), thermal, C, 0.3, 0, 0);
    parts.thA = thA; parts.thB = thB;
    const board = new THREE.Group(); C.add(board); parts.board = board;
    const pcb = mesh(new THREE.BoxGeometry(1.0, 0.035, 0.42), [chipM, chipM, pcbM, chipM, chipM, chipM], board);
    for (let i = 0; i < 4; i++) mesh(rbox(0.18, 0.05, 0.16, 0.012), chipM, board, -0.33 + i * 0.22, 0.04, -0.06);
    mesh(rbox(0.3, 0.04, 0.1, 0.01), chrome, board, 0.25, 0.035, 0.13);
    // pinger (ULB) at the front end of the module
    const pg2 = new THREE.Group(); pg2.position.set(CX - CL - 0.42, CY - 0.05, 0); R.add(pg2); parts.pinger = pg2;
    mesh(new THREE.CylinderGeometry(0.17, 0.17, 0.72, 28), darkMetal, pg2).rotation.z = Math.PI / 2;
    mesh(new THREE.CylinderGeometry(0.18, 0.18, 0.1, 28), chrome, pg2, -0.36, 0, 0).rotation.z = Math.PI / 2;
    mesh(new THREE.CylinderGeometry(0.19, 0.19, 0.06, 28), reflect, pg2, 0.15, 0, 0).rotation.z = Math.PI / 2;
    const led = new THREE.Mesh(new THREE.SphereGeometry(0.06, 12, 8), new THREE.MeshBasicMaterial({ color: 0x111111 })); led.position.set(-0.43, 0, 0); pg2.add(led); parts.led = led;
    R.traverse((o) => { if (o.isMesh) { o.castShadow = true; o.receiveShadow = true; } });
    return { R, parts };
  }
  const REC = buildRecorder(true); S.add(REC.R);
  const P = REC.parts;
  const REC2 = buildRecorder(false); S.add(REC2.R);

  // ---------- studio floor, AO pad, water surface ----------
  const FLOORY = -0.92;
  const floorM = new THREE.MeshStandardMaterial({ color: 0x24333a, roughness: 0.5, metalness: 0.15, transparent: true });
  const floor = new THREE.Mesh(new THREE.CircleGeometry(80, 64), floorM); floor.rotation.x = -Math.PI / 2; floor.position.y = FLOORY; floor.receiveShadow = true; S.add(floor);
  const aoTex = canvasTex(256, 256, (c, w) => { const g = c.createRadialGradient(w / 2, w / 2, 0, w / 2, w / 2, w / 2); g.addColorStop(0, "rgba(0,0,0,.75)"); g.addColorStop(0.55, "rgba(0,0,0,.3)"); g.addColorStop(1, "rgba(0,0,0,0)"); c.fillStyle = g; c.fillRect(0, 0, w, w); });
  const aoM = new THREE.MeshBasicMaterial({ map: aoTex, transparent: true, depthWrite: false });
  const ao = new THREE.Mesh(new THREE.PlaneGeometry(7.5, 3.6), aoM); ao.rotation.x = -Math.PI / 2; ao.position.set(-0.2, FLOORY + 0.005, 0); S.add(ao);
  const WU = { uT: { value: 0 }, uA: { value: 0 }, uE: { value: new THREE.Vector2(-0.3, 0) }, uR: { value: 0 }, uRa: { value: 0 }, uCam: { value: new THREE.Vector3() } };
  const water = new THREE.Mesh(new THREE.PlaneGeometry(400, 400, 1, 1), new THREE.ShaderMaterial({
    uniforms: WU, transparent: true, depthWrite: false, side: THREE.DoubleSide,
    vertexShader: "varying vec3 vW;void main(){vec4 w=modelMatrix*vec4(position,1.);vW=w.xyz;gl_Position=projectionMatrix*viewMatrix*w;}",
    fragmentShader: `varying vec3 vW;uniform float uT,uA,uR,uRa;uniform vec2 uE;uniform vec3 uCam;void main(){
      float rr=sin(vW.x*.9+uT*1.3)*sin(vW.z*.7-uT*1.1)+.5*sin((vW.x+vW.z)*2.1+uT*2.3)+.3*sin(vW.x*3.7-vW.z*2.9+uT*3.1);
      float ring=exp(-pow((length(vW.xz-uE)-uR)*2.2,2.))*uRa;float far=smoothstep(140.,20.,length(vW.xz-uCam.xz));vec3 c;float a;
      if(gl_FrontFacing){c=mix(vec3(.015,.05,.06),vec3(.08,.26,.3),.5+.22*rr)+vec3(.6,.9,.9)*ring;a=.94;}
      else{c=mix(vec3(.2,.62,.66),vec3(.75,1.05,1.),smoothstep(.7,1.5,rr))*1.15+ring;a=.9;}
      gl_FragColor=vec4(c,a*uA*far);}`,
  }));
  water.rotation.x = -Math.PI / 2; water.position.y = FLOORY + 0.01; S.add(water);

  // ---------- ghost airliner (generic, no livery) ----------
  function ghostMat(col, base = 0.008) {
    return new THREE.ShaderMaterial({
      transparent: true, depthWrite: false, blending: THREE.AdditiveBlending, side: THREE.DoubleSide,
      uniforms: { uA: { value: 0 }, uC: { value: new THREE.Color(col) }, uScan: { value: 999 }, uHi: { value: 0 }, uB: { value: base } },
      vertexShader: "varying vec3 vN,vV,vW;void main(){vec4 w=modelMatrix*vec4(position,1.);vW=w.xyz;vN=normalize(mat3(modelMatrix)*normal);vV=cameraPosition-w.xyz;gl_Position=projectionMatrix*viewMatrix*w;}",
      fragmentShader: `uniform float uA,uScan,uHi,uB;uniform vec3 uC;varying vec3 vN,vV,vW;void main(){float f=clamp(1.-abs(dot(normalize(vN),normalize(vV))),0.,1.);
        float a=uB+pow(f,3.)*.45;float sc=smoothstep(uScan-3.,uScan+3.,vW.x);float edge=exp(-pow((vW.x-uScan)*.18,2.));
