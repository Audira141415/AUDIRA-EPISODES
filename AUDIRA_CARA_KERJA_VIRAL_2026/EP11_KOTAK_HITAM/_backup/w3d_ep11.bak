  const SD = []; for (let i = 0; i < SPARK.n; i++) { const a = rnd() * 6.28, e = (rnd() - 0.3) * 1.6; SD.push(v3(Math.cos(a) * 0.4 + 0.6, Math.abs(Math.sin(e)) * 1.0 + 0.4, Math.sin(a)).normalize().multiplyScalar(3 + rnd() * 6)); }
