  const fillM = new THREE.MeshPhysicalMaterial({ color: 0x2aa6c2, roughness: 0.1, transparent: true, opacity: 0.38, depthWrite: false, emissive: 0x0a3a48, emissiveIntensity: 0.6 });
  const fill = mesh(new THREE.CylinderGeometry(1.5, 1.5, 1, 48), fillM, cham); fill.castShadow = false;
  const BUB = points(160, "varying float vA,vH;void main(){vec2 q=gl_PointCoord-.5;float d=length(q)*2.;if(d>1.)discard;float rim=smoothstep(.6,1.,d)*(1.-smoothstep(.95,1.,d));gl_FragColor=vec4(vec3(.7,1.,1.)*vA*(rim*1.4+.08),1.);}");
  const BD = []; for (let i = 0; i < BUB.n; i++) BD.push({ a: rnd() * 6.28, r: rnd() * 1.3, ph: rnd(), sp: 0.6 + rnd(), sz: 0.02 + rnd() * 0.05, te: rnd() });
