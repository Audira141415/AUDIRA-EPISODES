      vertexShader: "attribute float sz,al,hc;varying float vA,vH;void main(){vec4 mv=modelViewMatrix*vec4(position,1.);gl_Position=projectionMatrix*mv;gl_PointSize=sz*1400./max(.1,-mv.z);vA=al;vH=hc;}",
      fragmentShader: frag }));
    m.frustumCulled = false; S.add(m);
    return { g, m, P: g.attributes.position.array, Z: g.attributes.sz.array, A: g.attributes.al.array, Hc: g.attributes.hc.array, n };
  }
  const FIRE = points(520, "varying float vA,vH;void main(){vec2 q=gl_PointCoord-.5;float d=dot(q,q)*4.;if(d>1.)discard;vec3 c=mix(vec3(3.,2.4,1.2),vec3(1.6,.35,.05),vH);gl_FragColor=vec4(c*vA*pow(1.-d,1.6),1.);}");
