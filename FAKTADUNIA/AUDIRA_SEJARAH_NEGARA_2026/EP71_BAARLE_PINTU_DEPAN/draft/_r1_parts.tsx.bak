// EP71 Baarle — shared SATELLITEBRIEFING parts (memory recipe: emissive back panel, emissive grid,
// amber caps, amber scan line, dark FG silhouettes with amber caps, textured terrain).
import React, { useMemo } from "react";
import * as THREE from "three";
import { AssetModel } from "../core/assets/AssetModel.tsx";
import { useSurfaceGrain } from "../core/polish/Polish.tsx";
import { SceneText } from "../core/polish/Drei.tsx";
import type { V3 } from "./timeline.ts";

export const C = {
  void: "#070B0E",
  ground: "#2A3438",
  road: "#4A555B",
  amber: "#FFBE55",
  blue: "#3D86E8",
  white: "#F2F5F6",
  red: "#FF4A3D",
  panel: "#1976D2",
  sil: "#0F1418",
};

export const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
export const ease = (x: number) => {
  const c = clamp01(x);
  return c * c * (3 - 2 * c);
};
export const rng = (seed: number) => () => {
  seed = (seed * 16807) % 2147483647;
  return (seed - 1) / 2147483646;
};

const canvasTex = (w: number, h: number, draw: (g: CanvasRenderingContext2D) => void, repeat?: [number, number]) => {
  const c = document.createElement("canvas");
  c.width = w;
  c.height = h;
  draw(c.getContext("2d")!);
  const t = new THREE.CanvasTexture(c);
  t.colorSpace = THREE.SRGBColorSpace;
  if (repeat) {
    t.wrapS = t.wrapT = THREE.RepeatWrapping;
    t.repeat.set(repeat[0], repeat[1]);
  }
  t.anisotropy = 8;
  return t;
};

/** Textured ground: grain map + bump, roads as lighter strips. */
export const Ground: React.FC<{ size?: number; color?: string; roads?: boolean; seed?: number }> = ({ size = 40, color = C.ground, roads = true, seed = 11 }) => {
  const grain = useSurfaceGrain(seed, 0.35, 10);
  return (
    <group>
      <mesh rotation={[-Math.PI / 2, 0, 0]} receiveShadow>
        <planeGeometry args={[size, size]} />
        <meshStandardMaterial color={color} map={grain} bumpMap={grain} bumpScale={0.6} roughness={0.92} metalness={0.05} />
      </mesh>
      {roads
        ? [-3, -1.5, 0, 1.5, 3].map((x) => (
            <mesh key={`rx${x}`} rotation={[-Math.PI / 2, 0, 0]} position={[x + 0.62, 0.004, -1]} receiveShadow>
              <planeGeometry args={[0.16, 14]} />
              <meshStandardMaterial color={C.road} roughness={0.8} />
            </mesh>
          ))
        : null}
      {roads
        ? [-6, -3.6, -1.2, 1.2, 3.6].map((z) => (
            <mesh key={`rz${z}`} rotation={[-Math.PI / 2, 0, 0]} position={[0, 0.004, z + 0.55]} receiveShadow>
              <planeGeometry args={[12, 0.16]} />
              <meshStandardMaterial color={C.road} roughness={0.8} />
            </mesh>
          ))
        : null}
    </group>
  );
};

/** Emissive analyst grid laid over the ground (emissiveIntensity 3). */
export const Grid: React.FC<{ size?: number; cells?: number; opacity?: number }> = ({ size = 16, cells = 16, opacity = 0.5 }) => {
  const tex = useMemo(
    () =>
      canvasTex(
        256,
        256,
        (g) => {
          g.clearRect(0, 0, 256, 256);
          g.strokeStyle = "#7FD3FF";
          g.lineWidth = 3;
          g.strokeRect(0, 0, 256, 256);
        },
        [cells, cells],
      ),
    [cells],
  );
  return (
    <mesh rotation={[-Math.PI / 2, 0, 0]} position={[0, 0.012, -1]}>
      <planeGeometry args={[size, size]} />
      <meshStandardMaterial map={tex} emissiveMap={tex} emissive="#5FC2FF" emissiveIntensity={3} transparent opacity={opacity} depthWrite={false} color="#000000" />
    </mesh>
  );
};

/** Emissive screen panel behind the subject (#1976D2, ~2.2): a briefing wall with data columns. */
export const BackPanel: React.FC<{ position?: V3; w?: number; h?: number; t: number }> = ({ position = [0, 2.6, -9], w = 26, h = 7, t }) => {
  const tex = useMemo(
    () =>
      canvasTex(1024, 280, (g) => {
        g.fillStyle = "#04101E";
        g.fillRect(0, 0, 1024, 280);
        g.strokeStyle = "#2F7FD8";
        g.lineWidth = 2;
        for (let x = 0; x < 1024; x += 64) g.strokeRect(x + 4, 6, 56, 268);
        const r = rng(5);
        for (let i = 0; i < 90; i++) {
          g.fillStyle = r() > 0.85 ? "#FFBE55" : "#5FA8FF";
          g.fillRect(Math.floor(r() * 16) * 64 + 10, 14 + r() * 250, 12 + r() * 36, 4);
        }
      }),
    [],
  );
  return (
    <mesh position={position}>
      <planeGeometry args={[w, h]} />
      <meshStandardMaterial color="#000000" emissive={C.panel} emissiveMap={tex} emissiveIntensity={2.2 + Math.sin(t * 1.3) * 0.15} fog={false} />
    </mesh>
  );
};

/** Far horizon haze band, like atmosphere seen from orbit. */
export const HazeBand: React.FC<{ z?: number }> = ({ z = -14 }) => {
  const tex = useMemo(
    () =>
      canvasTex(4, 256, (g) => {
        const gr = g.createLinearGradient(0, 0, 0, 256);
        gr.addColorStop(0, "#070B0E");
        gr.addColorStop(0.45, "#0b1d36");
        gr.addColorStop(0.52, "#1a4a80");
        gr.addColorStop(0.6, "#0b1d36");
        gr.addColorStop(1, "#070B0E");
        g.fillStyle = gr;
        g.fillRect(0, 0, 4, 256);
      }),
    [],
  );
  return (
    <mesh position={[0, 2, z]}>
      <planeGeometry args={[80, 16]} />
      <meshBasicMaterial map={tex} fog={false} toneMapped={false} />
    </mesh>
  );
};

/** Sweeping amber scan line (emissive 4) moving along z. */
export const ScanLine: React.FC<{ t: number; z0?: number; z1?: number; width?: number; period?: number }> = ({ t, z0 = -7, z1 = 4, width = 14, period = 4.2 }) => {
  const u = (t / period) % 1;
  return (
    <group position={[0, 0.03, z0 + (z1 - z0) * u]}>
      <mesh>
        <boxGeometry args={[width, 0.02, 0.035]} />
        <meshStandardMaterial color={C.amber} emissive={C.amber} emissiveIntensity={4} toneMapped={false} />
      </mesh>
      <mesh rotation={[-Math.PI / 2, 0, 0]} position={[0, -0.01, -0.25]}>
        <planeGeometry args={[width, 0.5]} />
        <meshBasicMaterial color={C.amber} transparent opacity={0.12} depthWrite={false} />
      </mesh>
    </group>
  );
};

/** Dark FG silhouette (antenna mast) with an amber emissive cap; optional AUDIRA board (brand in-world). */
export const Silhouette: React.FC<{ position: V3; size?: number; board?: boolean; t: number }> = ({ position, size = 3, board, t }) => (
  <group position={position}>
    <AssetModel id="antenna-mast-0954b0" assetType="prop" size={size} ground tint={C.sil} roughness={0.9} metalness={0.2} />
    <mesh position={[0.02 * size, size * 1.0, 0]}>
      <sphereGeometry args={[0.035 * size, 16, 12]} />
      <meshStandardMaterial color={C.amber} emissive={C.amber} emissiveIntensity={3 + Math.sin(t * 5) * 1.2} toneMapped={false} />
    </mesh>
    {board ? (
      <group position={[0, size * 0.62, 0.12]}>
        <mesh>
          <planeGeometry args={[size * 0.42, size * 0.13]} />
          <meshStandardMaterial color="#0A1218" emissive="#0A1218" />
        </mesh>
        <mesh position={[0, -size * 0.062, 0.002]}>
          <planeGeometry args={[size * 0.42, size * 0.008]} />
          <meshStandardMaterial color={C.amber} emissive={C.amber} emissiveIntensity={3} toneMapped={false} />
        </mesh>
        <SceneText font="sans" fontSize={size * 0.07} letterSpacing={0.12} color={C.amber} anchorX="center" anchorY="middle" position={[0, 0, 0.004]}>
          AUDIRA
        </SceneText>
      </group>
    ) : null}
  </group>
);

/** Dashed white emissive border line from a to b (on the ground), drawn in over p (0..1). */
export const BorderLine: React.FC<{ a: [number, number]; b: [number, number]; p?: number; y?: number; dash?: number; color?: string; thick?: number }> = ({ a, b, p = 1, y = 0.03, dash = 0.16, color = C.white, thick = 0.05 }) => {
  const dx = b[0] - a[0];
  const dz = b[1] - a[1];
  const len = Math.hypot(dx, dz);
  const n = Math.floor(len / (dash * 2));
  const ang = Math.atan2(dx, dz);
  const shown = Math.floor(n * clamp01(p));
  return (
    <group>
      {Array.from({ length: shown }, (_, i) => {
        const u = (i * 2 + 0.5) / (n * 2);
        return (
          <mesh key={i} position={[a[0] + dx * u, y, a[1] + dz * u]} rotation={[0, ang, 0]}>
            <boxGeometry args={[thick, 0.025, dash]} />
            <meshStandardMaterial color={color} emissive={color} emissiveIntensity={2.4} toneMapped={false} />
          </mesh>
        );
      })}
    </group>
  );
};

/** Irregular enclave patch (extruded polygon) with an emissive cap; `on` 0..1 lights it. */
export const Patch: React.FC<{ x: number; z: number; r: number; seed: number; color: string; on: number; y?: number; flat?: boolean }> = ({ x, z, r, seed, color, on, y = 0.006, flat }) => {
  const geo = useMemo(() => {
    const rr = rng(seed * 97 + 13);
    const s = new THREE.Shape();
    const n = 6 + Math.floor(rr() * 3);
    for (let i = 0; i < n; i++) {
      const a = (i / n) * Math.PI * 2 + rr() * 0.4;
      const rad = r * (0.72 + rr() * 0.42);
      const px = Math.cos(a) * rad * 1.15;
      const py = Math.sin(a) * rad;
      if (i === 0) s.moveTo(px, py);
      else s.lineTo(px, py);
    }
    s.closePath();
    const g = new THREE.ExtrudeGeometry(s, { depth: flat ? 0.01 : 0.035, bevelEnabled: false });
    g.rotateX(-Math.PI / 2);
    return g;
  }, [r, seed, flat]);
  if (on <= 0.001) return null;
  const s = 0.6 + 0.4 * ease(on);
  return (
    <mesh geometry={geo} position={[x, y, z]} scale={[s, 1, s]}>
      <meshStandardMaterial color={color} emissive={color} emissiveIntensity={0.9 * on} transparent opacity={0.55 + 0.35 * on} roughness={0.6} depthWrite={false} />
    </mesh>
  );
};

/** World label with a dark plate (in-world callout). */
export const WorldLabel: React.FC<{ text: string; position: V3; color?: string; size?: number; on?: number; face?: number }> = ({ text, position, color = C.white, size = 0.22, on = 1, face = -0.9 }) => {
  if (on <= 0.01) return null;
  const w = size * (0.6 + text.length * 0.62);
  return (
    <group position={position} rotation={[face, 0, 0]} scale={0.7 + 0.3 * ease(on)}>
      <mesh>
        <planeGeometry args={[w, size * 1.7]} />
        <meshBasicMaterial color="#071014" transparent opacity={0.86 * on} />
      </mesh>
      <mesh position={[-w / 2 + size * 0.06, 0, 0.002]}>
        <planeGeometry args={[size * 0.12, size * 1.7]} />
        <meshBasicMaterial color={color} toneMapped={false} />
      </mesh>
      <SceneText font="sans" fontSize={size} letterSpacing={0.08} color={color} anchorX="center" anchorY="middle" position={[0, 0, 0.004]}>
        {text}
      </SceneText>
    </group>
  );
};

/** Pulsing target reticle ring on the ground (amber caps at the corners). */
export const Reticle: React.FC<{ position: V3; r?: number; on: number; t: number; color?: string }> = ({ position, r = 0.5, on, t, color = C.amber }) => {
  if (on <= 0.01) return null;
  const s = 1.8 - 0.8 * ease(on) + Math.sin(t * 6) * 0.03;
  return (
    <group position={position} scale={s}>
      <mesh rotation={[-Math.PI / 2, 0, 0]}>
        <ringGeometry args={[r * 0.92, r, 48]} />
        <meshBasicMaterial color={color} toneMapped={false} transparent opacity={on} side={THREE.DoubleSide} />
      </mesh>
      {[0, 1, 2, 3].map((i) => (
        <mesh key={i} rotation={[0, (i * Math.PI) / 2 + Math.PI / 4, 0]} position={[Math.cos((i * Math.PI) / 2 + Math.PI / 4) * r * 1.25, 0.02, -Math.sin((i * Math.PI) / 2 + Math.PI / 4) * r * 1.25]}>
          <boxGeometry args={[r * 0.35, 0.03, 0.05]} />
          <meshStandardMaterial color={color} emissive={color} emissiveIntensity={3} toneMapped={false} />
        </mesh>
      ))}
    </group>
  );
};

/** Plain building GLB (keeps its own brick colours). */
export const Building: React.FC<{ id: string; position: V3; size: number; rot?: number; tint?: string; emissive?: string; ei?: number }> = ({ id, position, size, rot = 0, tint, emissive, ei }) => (
  <group position={position} rotation={[0, rot, 0]}>
    <AssetModel id={id} assetType="building" size={size} ground tint={tint} emissive={emissive} emissiveIntensity={ei} />
  </group>
);
