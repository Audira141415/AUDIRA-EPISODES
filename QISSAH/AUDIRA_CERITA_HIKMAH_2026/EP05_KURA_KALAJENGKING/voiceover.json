  "meta": "F:/AUDIRA-VIDEO-MOTION/QISSAH/AUDIRA_CERITA_HIKMAH_2026/studio/public/audio/ep05/vo-meta.json",
  "_cast": {
    "narator": "Risa 6a3fe952",
    "kura": "Galang 04b567df (pelan, baik hati)",
    "kalajengking": "Andi a053f6bc (cepat, licik)"
  },
  "lead": 0.8,
  "tail": 8.0,
  "lines": [
    {
      "id": "s1a",
      "who": "narator",
      "speed": 0.93,
      "gap": 0.34,
      "text": "Kalau seseorang berjanji tidak akan menyakitimu..."
    },
    {
      "id": "s1b",
      "who": "narator",
      "speed": 0.93,
      "gap": 0.95,
      "text": "dan alasannya sangat masuk akal, apakah kamu akan percaya?"
    },
    {
      "id": "s2a",
      "who": "narator",
      "speed": 0.95,
      "gap": 0.41,
      "text": "Di tepi sungai yang lebar, kabut pagi menggantung di antara gunung."
    },
    {
      "id": "s2b",
      "who": "narator",
      "speed": 0.95,
      "gap": 0.34,
      "text": "Seekor kalajengking berdiri di ujung batu. Ia ingin ke seberang."
    },
    {
      "id": "s2c",
      "who": "narator",
      "speed": 0.95,
      "gap": 0.41,
      "text": "Masalahnya, kalajengking tidak bisa berenang."
    },
    {
      "id": "s2d",
      "who": "narator",
      "speed": 0.95,
      "gap": 0.41,
      "text": "Lalu ia melihat seekor kura-kura berjemur di dekat air."
    },
    {
      "id": "s2e",
      "who": "kalajengking",
      "voice": "a053f6bc-7df4-40de-96d4-de026bc47ce8",
      "speed": 1.05,
      "gap": 0.47,
      "text": "Hai, Kura-kura! Maukah kau memberiku tumpangan ke seberang?"
    },
    {
      "id": "s3a",
      "who": "kura",
      "voice": "04b567df-2923-4b0c-896b-4b7df0a07e1a",
      "speed": 0.9,
      "gap": 0.3,
      "text": "Apa? Kau pasti sudah gila."
    },
    {
      "id": "s3b",
      "who": "kura",
      "voice": "04b567df-2923-4b0c-896b-4b7df0a07e1a",
      "speed": 0.9,
      "gap": 0.47,
      "text": "Kalau kau naik ke punggungku, kau akan menyengatku di tengah sungai. Aku tenggelam."
    },
    {
      "id": "s3c",
      "who": "narator",
      "speed": 0.95,
      "gap": 0.41,
      "text": "Kalajengking itu malah tertawa kecil."
    },
    {
      "id": "s4a",
      "who": "kalajengking",
      "voice": "a053f6bc-7df4-40de-96d4-de026bc47ce8",
      "speed": 1.05,
      "gap": 0.3,
      "text": "Kura-kura yang baik... pikirkan. Kalau aku menyengatmu, kau tenggelam."
    },
    {
      "id": "s4b",
      "who": "kalajengking",
      "voice": "a053f6bc-7df4-40de-96d4-de026bc47ce8",
      "speed": 1.05,
      "gap": 0.3,
      "text": "Dan aku di atas punggungmu. Aku tidak bisa berenang. Aku ikut tenggelam."
    },
    {
      "id": "s4c",
      "who": "kalajengking",
      "voice": "a053f6bc-7df4-40de-96d4-de026bc47ce8",
      "speed": 1.05,
      "gap": 0.62,
      "text": "Jadi, apa untungnya bagiku? Tenanglah. Aku tidak akan menyengatmu."
    },
    {
      "id": "s5a",
      "who": "narator",
      "speed": 0.92,
      "gap": 0.41,
      "text": "Kura-kura terdiam. Ia menimbang kata-kata itu, satu per satu."
    },
    {
      "id": "s5b",
      "who": "narator",
      "speed": 0.92,
      "gap": 0.54,
      "text": "Logikanya rapi. Tidak ada celah yang bisa ia bantah."
    },
    {
      "id": "s5c",
      "who": "kura",
      "voice": "04b567df-2923-4b0c-896b-4b7df0a07e1a",
      "speed": 0.9,
      "gap": 0.41,
      "text": "Hmm... kau benar juga. Baiklah. Naiklah ke punggungku."
    },
    {
      "id": "s5d",
      "who": "narator",
      "speed": 0.95,
      "gap": 0.82,
      "text": "Kalajengking pun merayap naik ke tempurung kura-kura."
    },
    {
      "id": "s6a",
      "who": "narator",
      "speed": 0.93,
      "gap": 0.47,
      "text": "Kura-kura mulai berenang. Perlahan, membelah air yang dingin."
    },
    {
      "id": "s6b",
      "who": "narator",
      "speed": 0.93,
      "gap": 0.47,
      "text": "Tepian di belakang mereka semakin jauh. Kabut menutupi kaki gunung."
    },
    {
      "id": "s6c",
      "who": "narator",
      "speed": 0.93,
      "gap": 0.47,
      "text": "Sungai itu dalam. Tapi kura-kura terus mengayuh, sabar."
    },
    {
      "id": "s6d",
      "who": "narator",
      "speed": 0.88,
      "gap": 0.88,
      "text": "Lalu, tepat di tengah sungai..."
    },
    {
      "id": "s7a",
      "who": "narator",
      "speed": 0.95,
      "gap": 0.68,
      "text": "kalajengking itu mengangkat ekornya, dan menyengat leher kura-kura."
    },
    {
      "id": "s7b",
      "who": "narator",
      "speed": 0.92,
      "gap": 0.68,
      "text": "Racunnya menyebar. Kaki kura-kura melemas. Mereka berdua mulai tenggelam."
    },
    {
      "id": "s8a",
      "who": "kura",
      "voice": "04b567df-2923-4b0c-896b-4b7df0a07e1a",
      "speed": 0.85,
      "gap": 0.34,
      "text": "Kalajengking... kau sudah berjanji tidak akan menyengatku."
    },
    {
      "id": "s8b",
      "who": "kura",
      "voice": "04b567df-2923-4b0c-896b-4b7df0a07e1a",
      "speed": 0.85,
      "gap": 0.54,
      "text": "Kenapa kau lakukan itu? Sekarang kita berdua akan mati."
    },
    {
      "id": "s8c",
      "who": "narator",
      "speed": 0.92,
      "gap": 0.41,
      "text": "Kalajengking menunduk. Suaranya sedih."
    },
    {
      "id": "s8d",
      "who": "kalajengking",
      "voice": "a053f6bc-7df4-40de-96d4-de026bc47ce8",
      "speed": 0.92,
      "gap": 0.34,
      "text": "Maafkan aku, Kura-kura. Aku tidak bisa menahannya."
    },
    {
      "id": "s8e",
      "who": "kalajengking",
      "voice": "a053f6bc-7df4-40de-96d4-de026bc47ce8",
      "speed": 0.88,
      "gap": 0.68,
      "text": "Menyengat... itu sudah tabiatku."
    },
    {
      "id": "s8f",
      "who": "narator",
      "speed": 0.9,
      "gap": 1.09,
      "text": "Lalu air yang gelap menelan mereka berdua."
    },
    {
      "id": "s9a",
      "who": "narator",
      "speed": 0.92,
      "gap": 0.41,
      "text": "Kura-kura itu tidak bodoh. Ia mau mendengarkan logika. Tapi ia lupa satu hal."
    },
    {
      "id": "s9b",
      "who": "narator",
      "speed": 0.92,
      "gap": 0.62,
      "text": "Janji bisa diucapkan siapa saja. Tapi tabiat tidak bisa disembunyikan."
    },
    {
      "id": "s9c",
      "who": "narator",
      "speed": 0.9,
      "gap": 0.41,
      "text": "Kenali dulu karakter seseorang, sebelum kau menjadikannya teman."
    },
    {
      "id": "s9d",
      "who": "narator",
      "speed": 0.9,
      "gap": 0.68,
      "text": "Sebab perannya akan ikut menentukan arah hidupmu."
    },
    {
      "id": "s9e",
      "who": "narator",
      "speed": 0.88,
      "gap": 0.34,
      "text": "Teman itu seperti tombol lift."
    },
    {
      "id": "s9f",
      "who": "narator",
      "speed": 0.88,
      "gap": 0.41,
      "text": "Ia bisa membawamu naik... atau membawamu turun."
    }
  ]
}